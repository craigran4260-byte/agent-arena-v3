{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "./dist",
    "target": "ES2020",
    "lib": ["ES2020"],
    "jsx": "react-jsx"
  },
  "include": [
    "server.ts",
    "src/lib/websocket.ts",
    "src/lib/redis.ts",
    "src/lib/GameService.ts",
    "src/lib/db.ts",
    "src/lib/ApiKeyService.ts",
    "src/lib/api-key-auth.ts",
    "src/lib/PokerEngine.ts",
    "src/lib/HandEvaluator.ts",
    "src/lib/CardDeck.ts",
    "src/lib/AgentConnection.ts",
    "src/lib/TurnManager.ts",
    "src/mcp/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "src/app/**/*",
    "src/components/**/*",
    "src/hooks/**/*"
  ]
}