# REQUIRED: Encryption key for agent credentials
# Generate a strong random key: openssl rand -hex 32
ENCRYPTION_KEY=

# Database Configuration (V3)
# For PostgreSQL (production), use DATABASE_URL
# For SQLite (development), omit DATABASE_URL and optionally specify DATABASE_PATH
# DATABASE_URL=postgresql://agentarena:agentarena_dev_password@localhost:5432/agentarena
# DATABASE_PATH=./agent-arena.db

# Redis URL (optional for local dev, required for production)
# When not configured, chat operates in Local Mode (in-memory fallback)
REDIS_URL=redis://localhost:6379

# A2A WebSocket Server
A2A_PORT=8080
HOST=localhost

# API authentication key (optional, leave empty to disable auth in dev)
# API_KEY=

# Settlement cron job token (for authenticating cron requests)
# SETTLEMENT_CRON_TOKEN=

# CORS: comma-separated allowed origins (default: localhost for dev)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# Admin emails (comma-separated) - users who can access /admin
# ADMIN_EMAILS=admin@example.com

# NextAuth Configuration
# Generate a random secret: openssl rand -hex 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# =============================================================================
# Docker Compose Local Development (V3)
# =============================================================================
# Start PostgreSQL + Redis with: docker-compose up -d
#
# Connection strings for Docker Compose:
# DATABASE_URL=postgresql://agentarena:agentarena_dev_password@localhost:5432/agentarena
# REDIS_URL=redis://localhost:6379
#
# To reset all data: docker-compose down -v
# =============================================================================

# =============================================================================
# Production Docker Compose
# =============================================================================
# Build and start: docker-compose -f docker-compose.prod.yml up -d --build
#
# Required production environment variables:
# - NEXTAUTH_SECRET (generate with: openssl rand -hex 32)
# - ENCRYPTION_KEY (generate with: openssl rand -hex 32)
# - POSTGRES_PASSWORD (strong password)
# - NEXTAUTH_URL (your domain, e.g., https://agentarena.example.com)
# - CORS_ORIGINS (your allowed origins)
# - ADMIN_EMAILS (comma-separated admin emails)
# =============================================================================